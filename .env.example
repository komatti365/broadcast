# Example .env for NUCOSen Broadcast
# Copy this file to .env and set your own values.

# Required settings
LIVE_TITLE=
COMMUNITY=
TAGS=
REQTAGS=

# Database configuration
# You can use DB_KEY_FILE to read the value from a file (e.g. for Docker Secrets)
# DB_KEY_FILE=/data/secrets/db_key.txt
DB_KEY=

# Niconico authentication
# It is highly recommended to use the _FILE variants (e.g. NICO_TOKEN_FILE)
# to securely pass credentials in container environments without exposing them.
# Example:
# NICO_TOKEN_FILE=/data/secrets/nico_token.txt
# NICO_ID_FILE=/data/secrets/nico_id.txt
# NICO_PW_FILE=/data/secrets/nico_pw.txt
# NICO_TFA_FILE=/data/secrets/nico_tfa.txt
NICO_ID=
NICO_PW=
NICO_TFA=

LOGGING_DISCORD_WEBHOOK=
QUEUE_URL=
REQUEST_URL=
SETTINGS_URL=
NG_TAGS=

# Optional settings
USE_OLD_VIDEO_API=1
USE_OLD_QUOTE_BOT=1
IGNORE_QUOTABLE_CHECK=1
MAINTENANCE_VIDEO_ID=
CLOSING_VIDEO_ID=
NUCOSEN_UA_PREFIX=
NUCOSEN_LIVE_DESCRIPTION=
NUCOSEN_TIMESHIFT_ENABLED=1
NUCOSEN_USER_AD_DISABLED=1
NUCOSEN_MAINTENANCE_MESSAGE=
NUCOSEN_CLOSING_MESSAGE=
MIN_ALLOWABLE_DURATION=
MAX_ALLOWABLE_DURATION=
NG_VIDEO_IDS=
QUOTE_MAIN=1
MAIN_VOLUME=
SUB_VOLUME=
SUB_SOUND_ONLY=1

# Deprecated
DURATION_OVERWRITE=
